{
  "name": "butterfly-design-next",
  "description": "Butterfly Design Next is a minimalist Next.js starter built for speed and polish. It ships with a reusable, themeable UI kit, a clean project structure, and TypeScript-first conventions, so you can go from idea to launch without rebuilding the basics.",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "themes:build": "bun run src/packages/scripts/build-themes.ts",
    "predev": "bun run themes:build",
    "prebuild": "bun run themes:build",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "spell": "cspell \"**/*.{ts,tsx,md,json}\" --no-progress",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "analyze": "ANALYZE=true next build",
    "size": "size-limit",
    "deps:check": "syncpack lint",
    "deps:fix": "syncpack fix",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "commit": "cz",
    "verify": "bun run check:fix && bun run typecheck && bun run spell",
    "verify:ci": "bun run check && bun run typecheck && bun run spell",
    "prepare": "husky",
    "commitlint": "commitlint --edit"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@next/bundle-analyzer": "^16.4.2",
    "@size-limit/file": "^14.2.0",
    "@tailwindcss/turbopack": "^4",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "commitizen": "^4.3.2",
    "cspell": "^10.4.0",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "size-limit": "^14.2.0",
    "syncpack": "^15.3.3",
    "tailwindcss": "^4",
    "type-fest": "^5.10.0",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "packageManager": "bun@1.4.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "engines": {
    "node": ">=20.9.0",
    "bun": ">=1.2.0"
  },
  "license": "SEE LICENSE IN LICENSE"
}
