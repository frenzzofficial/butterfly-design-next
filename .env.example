# Copy to .env.local and adjust. Every variable is optional: the defaults in
# src/packages/env/*.env.ts apply when a value is unset.

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=butterfly-design-next
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_TITLE="Top 1% next.js starter template for your frontend development"
# NEXT_PUBLIC_OG_IMAGE_URL=/og.png

# Sub-path the site is served from, e.g. /butterfly-design-next on GitHub Pages
# project sites. Leave empty for a custom domain. Must be set at build time.
NEXT_PUBLIC_BASE_PATH=

# --- Look and feel ------------------------------------------------------------
# Any registered preset name from src/packages/configs/design-preset.config.ts
NEXT_PUBLIC_ACTIVE_DESIGN_PRESET=cyantrix-theme
# system | light | dark
NEXT_PUBLIC_ACTIVE_THEME=system

# --- SEO ----------------------------------------------------------------------
# NEXT_PUBLIC_GOOGLE_VERIFICATION=your-search-console-token

# --- Author and social --------------------------------------------------------
NEXT_PUBLIC_AUTHOR_NAME=frenzzofficial
NEXT_PUBLIC_AUTHOR_HANDLE=frenzzofficial
NEXT_PUBLIC_AUTHOR_EMAIL=contact@frenzz.in
NEXT_PUBLIC_CURRENT_REPOSITORY=butterfly-design-next
NEXT_PUBLIC_GITHUB=https://github.com/frenzzofficial
NEXT_PUBLIC_TWITTER=https://twitter.com/frenzzofficial
NEXT_PUBLIC_LINKEDIN=https://www.linkedin.com/company/frenzz/

# --- Static export --------------------------------------------------------------
# Set by `bun run build:export`; you normally do not need to set it yourself.
# STATIC_EXPORT=true
